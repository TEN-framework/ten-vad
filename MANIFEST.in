# Documentation and release/build configuration.
include LICENSE
include NOTICES
include README.md
include BUILDING_RELEASE.md
include requirements.txt
include pyproject.toml
include setup.py

# Public implementation, ONNX model, headers and reproducible ARM64 build tools.
recursive-include include *
recursive-include src *
recursive-include packaging *
recursive-include examples_onnx *
recursive-include examples *
recursive-include tests *.py

# These original prebuilt libraries are required by the default wheel builder.
include lib/Linux/x64/libten_vad.so
include lib/Windows/x64/ten_vad.dll
include lib/Windows/x86/ten_vad.dll
include lib/macOS/ten_vad.framework/Versions/A/ten_vad

# Repository metadata, generated packages and test caches are not source inputs.
prune .git
prune build
prune dist
global-exclude __pycache__ *.py[cod] .DS_Store
